{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokerogue-sbc.local/schema/species.schema.v3.json",
  "title": "Pokemon Species Schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "species_id",
    "starter_species_id",
    "name",
    "types",
    "base_stats"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "species_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "starter_species_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "prevolution_species_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z0-9_]+$"
    },
    "evolution_species_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "evolution_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evolution_rule"
      },
      "description": "Future-proof evolution criteria model. Runtime may implement criteria incrementally."
    },
    "pokedex_number": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/pokemon_type"
      }
    },
    "base_stats": {
      "$ref": "#/$defs/base_stats"
    },
    "catch_rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "base_friendship": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "base_exp": {
      "type": "integer",
      "minimum": 1
    },
    "growth_rate": {
      "type": "string",
      "enum": [
        "ERRATIC",
        "FAST",
        "MEDIUM_FAST",
        "MEDIUM_SLOW",
        "SLOW",
        "FLUCTUATING"
      ]
    },
    "starter_cost": {
      "type": "integer",
      "minimum": 1
    },
    "starter_moves": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "$defs": {
    "pokemon_type": {
      "type": "string",
      "enum": [
        "NORMAL",
        "FIRE",
        "WATER",
        "ELECTRIC",
        "GRASS",
        "ICE",
        "FIGHTING",
        "POISON",
        "GROUND",
        "FLYING",
        "PSYCHIC",
        "BUG",
        "ROCK",
        "GHOST",
        "DRAGON",
        "DARK",
        "STEEL",
        "FAIRY",
        "UNKNOWN"
      ]
    },
    "base_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "atk",
        "def",
        "sp_atk",
        "sp_def",
        "spd"
      ],
      "properties": {
        "hp": { "type": "integer", "minimum": 1, "maximum": 255 },
        "atk": { "type": "integer", "minimum": 1, "maximum": 255 },
        "def": { "type": "integer", "minimum": 1, "maximum": 255 },
        "sp_atk": { "type": "integer", "minimum": 1, "maximum": 255 },
        "sp_def": { "type": "integer", "minimum": 1, "maximum": 255 },
        "spd": { "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "species_enum_name"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "const": "dependency/pokerogue"
        },
        "species_enum_name": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "form_key": {
          "type": "string",
          "default": "DEFAULT"
        }
      }
    },
    "evolution_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z_]+$" },
        "value": { "type": "integer" },
        "move_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "species_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "gender": { "type": "string", "pattern": "^[A-Z_]+$" },
        "pokemon_type": { "$ref": "#/$defs/pokemon_type" },
        "item_key": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "time_of_day": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_]+$" },
          "uniqueItems": true
        },
        "biomes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "weather": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_]+$" },
          "uniqueItems": true
        },
        "natures": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_]+$" },
          "uniqueItems": true
        },
        "raw": { "type": "string" }
      }
    },
    "evolution_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_species_id", "min_level", "conditions"],
      "properties": {
        "target_species_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "item": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "evo_delay_levels": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "maxItems": 3
        },
        "pre_form_key": { "type": "string" },
        "evo_form_key": { "type": "string" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolution_condition" }
        }
      }
    }
  }
}
