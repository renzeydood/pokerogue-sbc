[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;
render_mode unshaded;

uniform vec2 crop_origin = vec2(0.0, 0.0);
uniform vec2 crop_size = vec2(1.0, 1.0);

void fragment() {
	vec2 crop_uv = crop_origin + (UV * crop_size);
	COLOR = texture(TEXTURE, crop_uv);
}
"

